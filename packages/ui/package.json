{
  "name": "@taste-and-see/ui",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Taste & See shared UI primitives — shadcn-style components (Button, Card, Input, Dialog) wired to @taste-and-see/design-tokens. Honors senior-mode hinges (tap-target, motion, contrast). See CLAUDE.md §8.2, §8.3.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tailwind-preset": "./tailwind.preset.cjs"
  },
  "files": [
    "dist",
    "tailwind.preset.cjs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "ladle": "ladle serve",
    "ladle:build": "ladle build",
    "clean": "rimraf dist build tsconfig.build.tsbuildinfo tsconfig.tsbuildinfo"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.0"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.2",
    "@radix-ui/react-slot": "1.1.0",
    "@taste-and-see/design-tokens": "workspace:*",
    "clsx": "2.1.1",
    "lucide-react": "0.460.0",
    "react-markdown": "9.0.1",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.0",
    "tailwind-merge": "2.5.4"
  },
  "devDependencies": {
    "@ladle/react": "5.0.0",
    "@taste-and-see/eslint-config": "workspace:*",
    "@taste-and-see/tsconfig": "workspace:*",
    "@types/node": "22.10.1",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@typescript-eslint/parser": "8.15.0",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.2",
    "eslint-plugin-react-hooks": "5.1.0",
    "jsdom": "25.0.1",
    "postcss": "8.5.14",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "rimraf": "6.0.1",
    "tailwindcss": "3.4.14",
    "typescript": "5.5.4",
    "vitest": "2.1.1"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
