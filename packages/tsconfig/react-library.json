{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Taste & See — React component library",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "target": "ES2022",
    "jsx": "react-jsx",
    "outDir": "dist",
    "rootDir": "src"
  },
  "exclude": ["node_modules", "dist", "build", "coverage", "**/*.spec.tsx", "**/*.test.tsx"]
}
