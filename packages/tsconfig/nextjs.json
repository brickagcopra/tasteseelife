{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Taste & See — Next.js 15 (App Router)",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "target": "ES2022",
    "jsx": "preserve",
    "noEmit": true,
    "allowJs": true,
    "incremental": true,
    "plugins": [{ "name": "next" }]
  },
  "exclude": ["node_modules", ".next", "out", "build", "coverage"]
}
