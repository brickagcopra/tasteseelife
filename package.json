{
  "name": "taste-and-see",
  "version": "0.0.0",
  "private": true,
  "description": "Taste & See — hospitality-driven culinary wellness and companion platform for aging adults",
  "engines": {
    "node": ">=22.11.0 <23",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "bundle:check": "node scripts/check-bundle-budget.mjs",
    "check": "turbo run check",
    "clean": "turbo run clean && rimraf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\" --ignore-path .gitignore",
    "commitlint": "commitlint --edit",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "infra:up": "docker compose up -d postgres redis",
    "infra:up:full": "docker compose --profile full up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "@commitlint/cli": "19.5.0",
    "@commitlint/config-conventional": "19.5.0",
    "@taste-and-see/eslint-config": "workspace:*",
    "@taste-and-see/prettier-config": "workspace:*",
    "@taste-and-see/tsconfig": "workspace:*",
    "@types/node": "22.10.1",
    "eslint": "8.57.0",
    "husky": "9.1.6",
    "lint-staged": "15.2.10",
    "prettier": "3.3.3",
    "rimraf": "6.0.1",
    "turbo": "2.1.3",
    "typescript": "5.5.4"
  },
  "workspaces": [
    "apps/*",
    "apps/workers/*",
    "packages/*"
  ],
  "pnpm": {
    "overrides": {
      "brace-expansion@<1.1.18": "1.1.18",
      "brace-expansion@>=2.0.0 <2.1.4": "2.1.4",
      "handlebars": "4.7.9",
      "lodash": "4.18.0",
      "postcss": "8.5.18",
      "sharp": "0.35.0",
      "tar": "7.5.19",
      "fast-uri": "3.1.5",
      "path-to-regexp": "8.4.0",
      "protobufjs": "7.6.1",
      "socket.io-parser": "4.2.7"
    }
  }
}
