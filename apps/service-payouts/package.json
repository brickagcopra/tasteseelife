{
  "name": "@taste-and-see/service-payouts",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Payouts bounded context (PDD §7.2 service inventory entry #11). Owns Stripe Connect Express onboarding for providers, the local cache of Stripe Connect account state (charges_enabled / payouts_enabled / requirements), and (TS-091) the T+2 disbursement schedule + provider payable balance + 1099 prep. TS-090 ships the NestJS 11 + Prisma + Postgres skeleton plus the Stripe Connect Express onboarding surface: provider self-service `POST /payouts/me/connect-account`, onboarding-link issuance, and the shared-secret-pinned internal `account.updated` ingest. Stripe SDK runs in stub mode when `STRIPE_SECRET_KEY` is absent — live SDK wiring lands as TS-090-followup-1. Decrement-on-payout-disbursed against service-accounting's Provider Payable account (TS-083-followup-9) lands with TS-091.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "tsc -p tsconfig.build.json --watch",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:boot-graph": "vitest run test/app-module-graph.test.ts",
    "test:watch": "vitest",
    "clean": "rimraf dist tsconfig.build.tsbuildinfo tsconfig.tsbuildinfo",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@nestjs/common": "11.0.0",
    "@nestjs/core": "11.0.0",
    "@nestjs/platform-express": "11.0.0",
    "@prisma/client": "5.22.0",
    "@taste-and-see/auth-sdk": "workspace:*",
    "@taste-and-see/contracts": "workspace:*",
    "@taste-and-see/logger": "workspace:*",
    "@taste-and-see/nest-auth": "workspace:*",
    "@taste-and-see/nest-common": "workspace:*",
    "@taste-and-see/nest-observability": "workspace:*",
    "@taste-and-see/nest-prisma-tenant-scope": "workspace:*",
    "@taste-and-see/sentry": "workspace:*",
    "@taste-and-see/tracing": "workspace:*",
    "jsonwebtoken": "9.0.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "stripe": "17.4.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@nestjs/testing": "11.0.0",
    "@taste-and-see/eslint-config": "workspace:*",
    "@taste-and-see/testing": "workspace:*",
    "@taste-and-see/tsconfig": "workspace:*",
    "@types/express": "5.0.0",
    "@types/jsonwebtoken": "9.0.7",
    "@types/node": "22.10.1",
    "eslint": "8.57.0",
    "prisma": "5.22.0",
    "rimraf": "6.0.1",
    "typescript": "5.5.4",
    "vitest": "2.1.1"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  }
}
