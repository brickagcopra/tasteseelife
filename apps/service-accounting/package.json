{
  "name": "@taste-and-see/service-accounting",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Accounting & Ledger bounded context (PDD §7.2 service #10; PDD §11.2). The financial source of truth for Taste & See — owns the chart of accounts, double-entry journals + journal lines, accounting periods, and the SaaS-metrics roll-ups. TS-080 ships the NestJS 11 + Prisma + Postgres skeleton with the SaaS-standard chart of accounts seeded via `pnpm seed:chart-of-accounts` + the read-only GET /api/v1/accounts catalog endpoint. The double-entry posting service (TS-081), revenue-recognition driver (TS-082), booking-commission entries (TS-083), coupon contra-revenue + refund reversals (TS-084), and period close (TS-085) land as expand-only follow-ups against this skeleton.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "tsc -p tsconfig.build.json --watch",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:boot-graph": "vitest run test/app-module-graph.test.ts",
    "test:watch": "vitest",
    "clean": "rimraf dist tsconfig.build.tsbuildinfo tsconfig.tsbuildinfo",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status",
    "prisma:studio": "prisma studio",
    "seed:chart-of-accounts": "node dist/scripts/seed-chart-of-accounts.js"
  },
  "dependencies": {
    "@nestjs/common": "11.0.0",
    "@nestjs/core": "11.0.0",
    "@nestjs/platform-express": "11.0.0",
    "@prisma/client": "5.22.0",
    "@taste-and-see/auth-sdk": "workspace:*",
    "@taste-and-see/contracts": "workspace:*",
    "@taste-and-see/logger": "workspace:*",
    "@taste-and-see/nest-auth": "workspace:*",
    "@taste-and-see/nest-common": "workspace:*",
    "@taste-and-see/nest-idempotency": "workspace:*",
    "@taste-and-see/nest-observability": "workspace:*",
    "@taste-and-see/nest-outbox": "workspace:*",
    "@taste-and-see/nest-outbox-consumer": "workspace:*",
    "@taste-and-see/nest-prisma-tenant-scope": "workspace:*",
    "@taste-and-see/sentry": "workspace:*",
    "@taste-and-see/tracing": "workspace:*",
    "decimal.js": "10.4.3",
    "ioredis": "5.4.1",
    "jsonwebtoken": "9.0.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "stripe": "17.4.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@nestjs/testing": "11.0.0",
    "@taste-and-see/eslint-config": "workspace:*",
    "@taste-and-see/testing": "workspace:*",
    "@taste-and-see/tsconfig": "workspace:*",
    "@types/express": "5.0.0",
    "@types/jsonwebtoken": "9.0.7",
    "@types/node": "22.10.1",
    "eslint": "8.57.0",
    "prisma": "5.22.0",
    "rimraf": "6.0.1",
    "typescript": "5.5.4",
    "vitest": "2.1.1"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  }
}
