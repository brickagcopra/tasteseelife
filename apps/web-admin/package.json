{
  "name": "@taste-and-see/web-admin",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Taste & See internal admin console (Next.js 15 + React 19, App Router). TS-123 skeleton: MFA-required login (no signup), super_admin-only dashboard placeholder, RBAC-gated protected routes. Server actions front the api-gateway BFF (apps/api-gateway) so the browser never contacts service-identity / service-subscription / service-audit directly.",
  "scripts": {
    "dev": "next dev -p 3300",
    "build": "next build",
    "start": "next start -p 3300",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "lint": "next lint --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf .next tsconfig.build.tsbuildinfo tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@sentry/nextjs": "10.69.0",
    "@taste-and-see/auth-sdk": "workspace:*",
    "@taste-and-see/contracts": "workspace:*",
    "@taste-and-see/design-tokens": "workspace:*",
    "@taste-and-see/sentry": "workspace:*",
    "@tiptap/extension-link": "2.11.5",
    "@tiptap/pm": "2.11.5",
    "@tiptap/react": "2.11.5",
    "@tiptap/starter-kit": "2.11.5",
    "next": "15.1.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tiptap-markdown": "0.8.10",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@taste-and-see/eslint-config": "workspace:*",
    "@taste-and-see/tsconfig": "workspace:*",
    "@types/node": "22.10.1",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "eslint": "8.57.0",
    "eslint-config-next": "15.1.0",
    "rimraf": "6.0.1",
    "typescript": "5.5.4",
    "vitest": "2.1.1"
  }
}
