{
  "name": "@taste-and-see/service-content",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Content & CMS bounded context (PDD §7.2 service inventory, PRD §10.10 Blog / §10.11 Help Center). Owns marketing pages, blog articles, and help-center categories with append-only versioning (`pages` / `page_versions` / `articles` / `article_versions` / `help_categories`, PDD §8.2 §19). TS-280 ships the NestJS 11 + Prisma + Postgres skeleton with the `content` schema + `/healthz` + `/readyz`, tenant-scoped per TS-141. The authenticated authoring surface (blog admin TS-281, page CMS TS-282, help-center TS-283) lands in subsequent TS-28x slices, at which point the JWT-verification + idempotency + Redis env clusters arrive (the service-academy / service-ads shape). The skeleton carries no dead config (the TS-070 / TS-221 convention).",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "tsc -p tsconfig.build.json --watch",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:boot-graph": "vitest run test/app-module-graph.test.ts",
    "test:watch": "vitest",
    "clean": "rimraf dist tsconfig.build.tsbuildinfo tsconfig.tsbuildinfo",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@nestjs/common": "11.0.0",
    "@nestjs/core": "11.0.0",
    "@nestjs/platform-express": "11.0.0",
    "@prisma/client": "5.22.0",
    "@taste-and-see/auth-sdk": "workspace:*",
    "@taste-and-see/contracts": "workspace:*",
    "@taste-and-see/logger": "workspace:*",
    "@taste-and-see/nest-audit": "workspace:*",
    "@taste-and-see/nest-auth": "workspace:*",
    "@taste-and-see/nest-common": "workspace:*",
    "@taste-and-see/nest-idempotency": "workspace:*",
    "@taste-and-see/nest-observability": "workspace:*",
    "@taste-and-see/nest-outbox": "workspace:*",
    "@taste-and-see/nest-prisma-tenant-scope": "workspace:*",
    "@taste-and-see/sentry": "workspace:*",
    "@taste-and-see/tracing": "workspace:*",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@nestjs/testing": "11.0.0",
    "@taste-and-see/eslint-config": "workspace:*",
    "@taste-and-see/testing": "workspace:*",
    "@taste-and-see/tsconfig": "workspace:*",
    "@types/express": "5.0.0",
    "@types/node": "22.10.1",
    "eslint": "8.57.0",
    "prisma": "5.22.0",
    "rimraf": "6.0.1",
    "typescript": "5.5.4",
    "vitest": "2.1.1"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  }
}
