# Taste & See — example environment values for local development.
# Copy to `.env` and edit. NEVER commit `.env` (see .gitignore + CLAUDE.md §3.5).
# Production secrets live in Vault / cloud secret manager — never here.

NODE_ENV=development

# --- Postgres (docker-compose) ---
POSTGRES_USER=tastesee
POSTGRES_PASSWORD=tastesee_dev_only
POSTGRES_DB=tastesee
POSTGRES_PORT=5432
DATABASE_URL=postgresql://tastesee:tastesee_dev_only@localhost:5432/tastesee?schema=public

# --- Redis (docker-compose) ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
# Optional — idempotency cache TTLs (TS-044, @taste-and-see/nest-idempotency).
# Completed-response TTL matches CLAUDE.md §3.3 default (24h = 86400s).
# In-flight marker TTL caps how long a stuck handler can block retries.
# IDEMPOTENCY_TTL_SECONDS=86400
# IDEMPOTENCY_IN_FLIGHT_TTL_SECONDS=60

# --- Cassandra (opt-in profile) ---
# Only CASSANDRA_PORT is live — docker-compose interpolates it. No service
# reads Cassandra from env yet (PDD §4.2 puts messages / audit / activity there,
# but none of that wiring has landed), so the client settings below are
# commented out rather than left looking connected.
CASSANDRA_PORT=9042
# CASSANDRA_CONTACT_POINTS=localhost
# CASSANDRA_LOCAL_DATACENTER=dc1

# --- OpenSearch (opt-in profile) ---
OPENSEARCH_PORT=9200
# service-search reads ELASTICSEARCH_NODE_URL — NOT OPENSEARCH_NODE, which is
# what this file used to document and which nothing has ever read. Leaving it
# unset is a supported mode: absence forces the search stub, which is what the
# E2E fleet and a default `pnpm infra:up` both want. Uncomment only after
# starting the opt-in OpenSearch container, or search will fail to connect
# instead of stubbing.
# ELASTICSEARCH_NODE_URL=http://localhost:9200

# --- MailHog (opt-in profile) ---
# The container is here for when an SMTP transport lands. service-notification
# currently sends through Postmark (POSTMARK_SERVER_TOKEN), so nothing reads a
# generic SMTP host/port — setting them would have done nothing at all.
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# --- Stripe (test keys only — never commit live keys) ---
# STRIPE_WEBHOOK_SECRET must be ≥ 20 chars (service-webhook env validation,
# TS-041a). The local stripe-cli prints a real one with
# `stripe listen --print-secret`; the placeholder below satisfies the
# length check so dev bootstrap doesn't fail before you wire the real one.
STRIPE_SECRET_KEY=sk_test_dev_placeholder_not_a_real_key
STRIPE_WEBHOOK_SECRET=whsec_replace_me_with_real_stripe_cli_output
# The publishable key is a browser-side credential and no portal mounts Stripe
# Elements yet — nothing reads this. Uncomment when a client-side checkout
# lands, as a NEXT_PUBLIC_* value inlined at image build time.
# STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
# Optional — pinned in the Stripe Dashboard endpoint config.
# STRIPE_API_VERSION=2025-09-30.basil
# Optional — replay-rejection window in seconds (clamped to [60, 900]).
# STRIPE_WEBHOOK_TOLERANCE_SECONDS=300

# --- Auth ---
# There is deliberately no JWT_REFRESH_SECRET. Refresh tokens on this platform
# are opaque random strings, not JWTs — the DB-stored SHA-256 hash is the whole
# verification path, so no signing key exists to configure (service-identity's
# env.ts documents the design). This file used to list one, which read as a
# secret someone had forgotten to set.
JWT_ACCESS_SECRET=replace_me_locally_with_at_least_32_chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# --- Email verification (TS-510) ---
# Lifetime of a single-use email-verification token. Optional — the schema
# defaults to 24h and clamps to [5 min, 7 days]. Signup creates an account in
# `pending_verification` and login requires `active`, so this token is the only
# path between the two; a value outside the clamp is a deploy-time typo, not a
# policy choice.
# EMAIL_VERIFICATION_TTL_SECONDS=86400

# --- MFA (TS-023) ---
# Base64 of an exactly-32-byte AES-256 key. Generate locally with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# In production this comes from Vault / AWS Secrets Manager (CLAUDE.md §3.5).
MFA_TOTP_ENC_KEY=dGFzdGUtYW5kLXNlZS1kZXYtcGxhY2Vob2xkZXItazM=
MFA_TOTP_ENC_KEY_VERSION=1
# Separate signing secret from JWT_ACCESS_SECRET — see env.ts threat model.
MFA_CHALLENGE_SECRET=replace_me_locally_with_at_least_32_chars
MFA_CHALLENGE_TTL_SECONDS=300
MFA_TOTP_PERIOD_SECONDS=30
MFA_TOTP_DIGITS=6
MFA_TOTP_WINDOW=1
MFA_TOTP_ISSUER=Taste & See

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOG_LEVEL=debug
# Sentry error reporting (CLAUDE.md §10). Wired into every service through
# createObservabilityBootstrap, so setting this is all that is required to turn
# reporting on. Left EMPTY here on purpose: locally you want the fleet to boot
# without shipping errors to a third party, and an empty value is the documented
# "declared, off" state — the services log why reporting is off rather than
# staying quiet about it.
SENTRY_DSN=

# --- web-family (apps/web-family, TS-121) ---
# Server-side base URL the portal's server actions use to reach the
# gateway BFF. NEVER points at a downstream service directly.
API_GATEWAY_BASE_URL=http://localhost:3000
# Optional cookie-name overrides — defaults are tas_family_access and
# tas_family_refresh respectively.
# SESSION_COOKIE_NAME=tas_family_access
# REFRESH_COOKIE_NAME=tas_family_refresh

# --- web-provider (apps/web-provider, TS-122) ---
# Same gateway base URL as web-family (the two portals share the BFF).
# Cookie-name defaults differ so the two portals coexist locally without
# colliding cookie jars: tas_provider_access and tas_provider_refresh.
# Override only if the deployment cookie scope differs.
# (No additional env required — API_GATEWAY_BASE_URL above is reused.)
# SESSION_COOKIE_NAME=tas_provider_access
# REFRESH_COOKIE_NAME=tas_provider_refresh

# --- web-admin (apps/web-admin, TS-123) ---
# Same gateway base URL as web-family / web-provider (all three portals
# share the BFF). Cookie-name defaults differ so the three portals
# coexist locally without colliding cookie jars. The MFA challenge
# cookie carries the single-use challenge JWT between the login and
# verify hops (5-min lifetime, matching service-identity's
# MFA_CHALLENGE_TTL_SECONDS).
# SESSION_COOKIE_NAME=tas_admin_access
# REFRESH_COOKIE_NAME=tas_admin_refresh
# MFA_CHALLENGE_COOKIE_NAME=tas_admin_mfa_challenge

# --- web-marketing (apps/web-marketing) ---
# Public blog reads reuse API_GATEWAY_BASE_URL above (TS-282-followup-3).
# Disqus comments on /blog/[slug] (TS-289-followup-1): the embed renders ONLY
# when a shortname is set — leave unset to keep comments dark. NEXT_PUBLIC_*
# values are inlined at BUILD time (set them in the image build, not the pod).
# NEXT_PUBLIC_DISQUS_SHORTNAME=tastesee
# Absolute site origin used for the Disqus page.url when an article has no
# canonical URL. Optional — threads key on the identifier without it.
# NEXT_PUBLIC_SITE_ORIGIN=https://tasteandsee.example.com

# --- api-gateway → service-trust-safety (TS-301a) ---
# Downstream base URL for the trust & safety intake proxy
# (POST /api/v1/trust-safety/incidents). Optional at boot — unset routes
# answer 503 with a config-specific detail. Local default matches the
# service's port allocation (3026).
# TRUST_SAFETY_SERVICE_BASE_URL=http://localhost:3026

# ===========================================================================
# Per-service secrets and internal wiring (TS-504)
# ===========================================================================
#
# Everything above documents *shared* infrastructure. Everything below is
# per-service, and every one of these is REQUIRED by some app's zod env
# schema with no default — so the app refuses to boot without it. A fresh
# clone previously could not start most of the fleet from the documented env.
#
# The values here are development placeholders chosen to satisfy each
# schema's own validation (length floors, base64/AES-256 key sizes, URL
# shape). They are NOT secrets and must never be reused anywhere real:
# production values come from Vault / the cloud secret manager
# (CLAUDE.md §3.5), never from a file in the repo.
#
# Regenerate any AES-256 key with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Regenerate any shared secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# --- Encryption keys (base64 of exactly 32 bytes — AES-256) ---
# Each protects a distinct class of data at rest and each is separately
# rotatable; do NOT collapse them onto one key.
KYC_PAYLOAD_ENC_KEY=dGFzdGUtYW5kLXNlZS1kZXYtcGxhY2Vob2xkZXItazM=
HOUSEHOLD_INTAKE_ENC_KEY=dGFzdGUtYW5kLXNlZS1kZXYtcGxhY2Vob2xkZXItazM=
HOUSEHOLD_ACCESS_ENC_KEY=dGFzdGUtYW5kLXNlZS1kZXYtcGxhY2Vob2xkZXItazM=
BACKGROUND_CHECK_PAYLOAD_ENC_KEY=dGFzdGUtYW5kLXNlZS1kZXYtcGxhY2Vob2xkZXItazM=

# --- Internal service-to-service shared secrets ---
# These authenticate the `/api/v1/internal/...` routes one service (or a
# worker) calls on another. Caller and callee must hold the SAME value, so
# a single dev placeholder per pair is deliberate here — in every real
# environment they are distinct, rotatable secrets.
ACADEMY_CERTIFICATION_RENEWALS_INTERNAL_API_KEY=dev-only-internal-key-0123456789abcdef
ACADEMY_CERTIFICATION_RENEWALS_API_KEY=dev-only-internal-key-0123456789abcdef
ACCOUNTING_SAAS_METRICS_INTERNAL_API_KEY=dev-only-internal-key-0123456789abcdef
ACTIVITY_INGEST_API_KEY=dev-only-internal-key-0123456789abcdef
ADS_INTERNAL_API_KEY=dev-only-internal-key-0123456789abcdef
ANALYTICS_AGGREGATION_INTERNAL_API_KEY=dev-only-internal-key-0123456789abcdef
AUDIT_INGEST_API_KEY=dev-only-internal-key-0123456789abcdef
BACKGROUND_CHECK_WEBHOOK_INTERNAL_API_KEY=dev-only-internal-key-0123456789abcdef
BOOKING_TIER_DISPATCH_API_KEY=dev-only-internal-key-0123456789abcdef
BOOKING_WELLNESS_SUMMARY_INTERNAL_API_KEY=dev-only-internal-key-0123456789abcdef
HOUSEHOLD_MEMBERSHIPS_INTERNAL_API_KEY=dev-only-internal-key-0123456789abcdef
HOUSEHOLD_VISIT_PREP_INTERNAL_API_KEY=dev-only-internal-key-0123456789abcdef
HOUSEHOLD_WELLNESS_SUMMARY_INTERNAL_API_KEY=dev-only-internal-key-0123456789abcdef
IDENTITY_PRIVACY_EXPORT_API_KEY=dev-only-internal-key-0123456789abcdef
IDENTITY_RECIPIENT_CONTACTS_API_KEY=dev-only-internal-key-0123456789abcdef
INTERNAL_AGGREGATION_API_KEY=dev-only-internal-key-0123456789abcdef
INTERNAL_POST_JOURNAL_API_KEY=dev-only-internal-key-0123456789abcdef
KYC_WEBHOOK_INTERNAL_API_KEY=dev-only-internal-key-0123456789abcdef
MEDIA_SCAN_EVENTS_API_KEY=dev-only-internal-key-0123456789abcdef
NOTIFICATION_DISPATCH_API_KEY=dev-only-internal-key-0123456789abcdef
NOTIFICATION_RENDER_API_KEY=dev-only-internal-key-0123456789abcdef
PAYOUT_TRANSFERS_API_KEY=dev-only-internal-key-0123456789abcdef
PROVIDER_BILLING_CONTACTS_INTERNAL_API_KEY=dev-only-internal-key-0123456789abcdef
PROVIDER_DISCOVERY_INTERNAL_API_KEY=dev-only-internal-key-0123456789abcdef
SEARCH_INDEX_API_KEY=dev-only-internal-key-0123456789abcdef
STRIPE_EVENTS_API_KEY=dev-only-internal-key-0123456789abcdef
STRIPE_RECONCILIATION_INTERNAL_API_KEY=dev-only-internal-key-0123456789abcdef

# The api-gateway signs the trust headers it forwards downstream with this;
# every service verifies against it. Not an API key — a signing secret.
INTERNAL_TRUST_SIGNING_SECRET=dev-only-trust-signing-secret-0123456789abcdef

# --- Service base URLs (workers + gateway call these) ---
# Localhost + each service's own default PORT, for running the fleet from
# source. In-cluster these are the Kubernetes Service DNS names and are set
# per-overlay, not from this file.
#
# Every service declares a distinct default PORT (TS-504-followup-1 moved
# booking→3027, notification→3028, payouts→3029 off three shared defaults),
# so the whole fleet runs from source with no PORT overrides. A test in
# `packages/testing` keeps the set distinct.
#
# Every `*_SERVICE_BASE_URL` the gateway's env schema declares is listed here
# (TS-505d2-followup-4). All but subscription's are `.optional()`, so a missing
# one does not fail boot — the gateway answers 503 `not_configured` instead,
# which is why seven of them were absent from this file and from the gateway's
# k8s ConfigMap without anything complaining.
ACADEMY_SERVICE_BASE_URL=http://127.0.0.1:3022
ACCOUNTING_SERVICE_BASE_URL=http://127.0.0.1:3015
ADS_SERVICE_BASE_URL=http://127.0.0.1:3024
ANALYTICS_SERVICE_BASE_URL=http://127.0.0.1:3023
AUDIT_SERVICE_BASE_URL=http://127.0.0.1:3016
BOOKING_SERVICE_BASE_URL=http://127.0.0.1:3027
CONCIERGE_SERVICE_BASE_URL=http://127.0.0.1:3021
CONTENT_SERVICE_BASE_URL=http://127.0.0.1:3025
HOUSEHOLD_SERVICE_BASE_URL=http://127.0.0.1:3011
IDENTITY_SERVICE_BASE_URL=http://127.0.0.1:3010
MEDIA_SERVICE_BASE_URL=http://127.0.0.1:3019
NOTIFICATION_SERVICE_BASE_URL=http://127.0.0.1:3028
PAYOUTS_SERVICE_BASE_URL=http://127.0.0.1:3029
PROVIDER_SERVICE_BASE_URL=http://127.0.0.1:3014
SEARCH_SERVICE_BASE_URL=http://127.0.0.1:3020
SUBSCRIPTION_SERVICE_BASE_URL=http://127.0.0.1:3012
TRUST_SAFETY_SERVICE_BASE_URL=http://127.0.0.1:3026

# ---------------------------------------------------------------------------
# TS-042-followup-3a2 — the dunning ladder (service-notification's first
# outbox consumer). DUNNING_BILLING_URL is REQUIRED with no default: it is the
# link every dunning email carries, and a mailer that guessed it would send a
# family a broken address at the worst possible moment. It points at the
# family billing surface that EXISTS — a READ-ONLY invoices page; there is no
# self-serve card-update route yet (TS-042-followup-3a3-followup-1) and the
# template copy is written around that.
#
# DUNNING_APP_NAME and DUNNING_NOTIFICATIONS_ENABLED both have schema
# defaults; stated here so the local posture is visible.
# ---------------------------------------------------------------------------
DUNNING_BILLING_URL=http://127.0.0.1:3001/billing/invoices
DUNNING_APP_NAME=Taste & See
DUNNING_NOTIFICATIONS_ENABLED=true

# --- Checkr (background checks, service-provider + service-webhook) ---
# Sandbox credentials only. The webhook secret verifies inbound callbacks and
# has a different lifecycle from the API key (CLAUDE.md §3.5).
CHECKR_API_KEY=dev-only-checkr-sandbox-key-0123456789
CHECKR_WEBHOOK_SECRET=dev-only-checkr-webhook-secret-0123456789

# --- S3 / object storage (service-media) ---
S3_BUCKET_NAME=tastesee-dev-media
S3_SIGNING_SECRET=dev-only-s3-signing-secret-0123456789abcdef

# --- Stripe Identity (service-identity KYC redirect) ---
STRIPE_IDENTITY_RETURN_URL=http://127.0.0.1:3000/account/verification/complete

# --- worker-outbox-relay ---
# Comma-separated `schema.table` list of outbox tables the relay drains into
# Redis Streams. Every schema that produces events must appear here or its
# events are written and never published.
#
# This lists EVERY schema that owns an `outbox_events` table, including the few
# with no producer yet (TS-505d2-followup-1). Adding a source only when the
# first producer lands is what left `search.outbox_events` undrained while two
# emitters appended to it on every search and every click — so the rule is now
# "the table exists, therefore it is drained". Polling an empty source costs one
# indexed lookup against the `dispatched_at IS NULL` partial index.
# `packages/testing/src/boot/outbox-sources-coverage.test.ts` keeps this list and
# the k8s ConfigMap in agreement with the schemas that actually exist.
#
# The relay's DATABASE_URL must have read/update access to every schema listed
# here (Phase-1 single Postgres, schema-per-service).
OUTBOX_SOURCES=accounting.outbox_events,ads.outbox_events,booking.outbox_events,content.outbox_events,household.outbox_events,identity.outbox_events,provider.outbox_events,search.outbox_events,subscription.outbox_events,trust_safety.outbox_events,webhook.outbox_events
