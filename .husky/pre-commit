# Pre-commit hook for Taste & See. See CLAUDE.md §2.4.
#
# Runs:
#   1. lint-staged — eslint --fix + prettier on staged files (per-file).
#   2. turbo type-check + test on packages affected by the staged changes.
#
# The turbo step uses `--filter='...[HEAD]'` to scope to packages that changed
# vs. the latest commit. CI (TS-009) runs the full graph; this hook is the fast
# local gate.
#
# This comment used to claim that on a brand-new repo without a prior commit the
# filter "resolves to no affected packages and turbo exits cleanly". It does not.
# turbo 2.1.3 fails outright:
#
#   x Unable to query SCM: git error: fatal: ambiguous argument 'HEAD':
#   | unknown revision or path not in the working tree.
#
# `...[HEAD]` asks git to diff against a revision that does not exist until the
# first commit lands, so the one case the comment described was the one case
# that was broken — invisibly, because the repository had no commits and the
# hook had therefore never run. Guarding on HEAD makes the claim true.

pnpm exec lint-staged

if git rev-parse --verify --quiet HEAD >/dev/null 2>&1; then
  pnpm exec turbo run type-check test --filter='...[HEAD]' --output-logs=errors-only --continue
else
  echo "pre-commit: no prior commit, so there is nothing to diff against —"
  echo "            skipping the affected-package type-check/test."
  echo "            CI runs the full graph on push."
fi
